+fn outer_sandbox_provides_ipc_isolation() -> bool {
+    std::env::var("AGENTWRAP_SANDBOX").as_deref() == Ok("true")
+}
+
+fn append_ipc_isolation_arg(args: &mut Vec<String>) {
+    if !outer_sandbox_provides_ipc_isolation() {
+        args.push("--unshare-ipc".to_string());
+    }
+}
