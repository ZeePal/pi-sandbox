#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TAG="${CODEX_VENDOR_TAG:-rust-v0.140.0}"
VENDOR_DIR="$ROOT_DIR/vendor/openai/codex"
PATCH_FILE="$ROOT_DIR/patches/codex-linux-sandbox-unix-sockets.patch"

if [[ -d "$VENDOR_DIR/.git" ]]; then
    current_tag="$(git -C "$VENDOR_DIR" describe --tags --exact-match 2>/dev/null || true)"
    if [[ "$current_tag" != "$TAG" ]]; then
        rm -rf "$VENDOR_DIR"
    fi
fi

if [[ ! -d "$VENDOR_DIR/.git" ]]; then
    mkdir -p "$(dirname "$VENDOR_DIR")"
    git clone --depth 1 --branch "$TAG" https://github.com/openai/codex.git "$VENDOR_DIR"
fi

if ! git -C "$VENDOR_DIR" apply --reverse --check "$PATCH_FILE" >/dev/null 2>&1; then
    git -C "$VENDOR_DIR" apply "$PATCH_FILE"
fi

printf 'Prepared Codex vendor at %s (%s)\n' "$VENDOR_DIR" "$TAG"
